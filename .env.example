# Runtime configuration for the deployed stack. Copy to .env next to
# docker-compose.yml (in Arcane: the project's .env) and fill in.
# Nothing here is baked into the image — changing it only needs a redeploy.

# Admin password for the settings/admin panel. REQUIRED: the stack refuses to
# start without it, because the app would otherwise fall back to "admin123".
ADMIN_PASSWORD=change_me

# Host port the container is published on (the container always listens on
# 3000). nginx-proxy-manager proxies to this port. Default: 3010
HOST_PORT=3010

# Node environment. Default: production
NODE_ENV=production
